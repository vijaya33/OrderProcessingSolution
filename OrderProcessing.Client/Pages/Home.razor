@page "/"
@inject OrderProcessing.Client.Services.IOrderApiClient Api
<PageTitle>Orders</PageTitle><div class="title-row"><div><h1>Orders</h1><p>Create, price, and refresh customer orders.</p></div><button class="primary" @onclick="NewOrder">New order</button></div>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert">@error</div>}
@if(loading){<p>Loading…</p>}else if(editing is not null){<EditForm Model="editing" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><ValidationSummary/><section><label>Customer name <InputText @bind-Value="editing.CustomerName" /></label><label>Email <InputText @bind-Value="editing.CustomerEmail" /></label><div class="grid"><label>Discount % <InputNumber @bind-Value="editing.DiscountPercent" /></label><label>Tax % <InputNumber @bind-Value="editing.TaxPercent" /></label><label>Shipping <InputNumber @bind-Value="editing.ShippingAmount" /></label><label>Status <InputSelect @bind-Value="editing.Status">@foreach(var s in Enum.GetValues<OrderStatus>()){<option value="@s">@s</option>}</InputSelect></label></div><h2>Items</h2>@foreach(var item in editing.Items){<div class="item-row"><InputText @bind-Value="item.ProductName" placeholder="Product"/><InputNumber @bind-Value="item.Quantity"/><InputNumber @bind-Value="item.UnitPrice"/><span>@item.LineTotal.ToString("C")</span><button type="button" @onclick="()=>RemoveItem(item.Id)">Remove</button></div>}<button type="button" @onclick="AddItem">Add item</button><div class="actions"><button class="primary" disabled="@saving">@(saving?"Saving…":"Save order")</button><button type="button" @onclick="Cancel">Cancel</button></div></section></EditForm>}else{<div class="cards">@foreach(var row in orders){<article><h2>@row.Order.CustomerName</h2><p>@row.Order.Status · @row.Summary.TotalQuantity item(s)</p><strong>@row.Summary.GrandTotal.ToString("C")</strong><div class="actions"><button @onclick="()=>Edit(row.Order)">Edit</button><button @onclick="()=>RefreshAsync(row.Order.Id)">Refresh</button><button class="danger" @onclick="()=>DeleteAsync(row.Order.Id)">Delete</button></div></article>}</div>}
@code{
 private IReadOnlyList<OrderResponse> orders=[]; private Order? editing; private bool loading=true,saving; private string? error;
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync(){try{loading=true;error=null;orders=await Api.GetAllAsync();}catch(Exception ex){error=ex.Message;}finally{loading=false;}}
 private void NewOrder()=>editing=new(){Id=Guid.Empty,Items=[new()]};
 private static Order Copy(Order x)=>new(){Id=x.Id,CustomerName=x.CustomerName,CustomerEmail=x.CustomerEmail,CreatedUtc=x.CreatedUtc,Status=x.Status,DiscountPercent=x.DiscountPercent,TaxPercent=x.TaxPercent,ShippingAmount=x.ShippingAmount,Items=x.Items.Select(i=>new OrderItem{Id=i.Id,ProductName=i.ProductName,Quantity=i.Quantity,UnitPrice=i.UnitPrice}).ToList()};
 private void Edit(Order order)=>editing=Copy(order); private void Cancel()=>editing=null; private void AddItem()=>editing!.Items.Add(new()); private void RemoveItem(Guid id)=>editing!.Items.RemoveAll(x=>x.Id==id);
 private async Task SaveAsync(){try{saving=true;error=null;if(editing!.Items.Count==0){error="Add at least one item.";return;}var response=editing.Id==Guid.Empty?await Api.CreateAsync(editing):await Api.UpdateAsync(editing);orders=orders.Where(x=>x.Order.Id!=response.Order.Id).Append(response).OrderByDescending(x=>x.Order.CreatedUtc).ToArray();editing=null;}catch(Exception ex){error=ex.Message;}finally{saving=false;}}
 private async Task RefreshAsync(Guid id){try{var fresh=await Api.GetAsync(id);orders=orders.Select(x=>x.Order.Id==id?fresh:x).ToArray();}catch(Exception ex){error=ex.Message;}}
 private async Task DeleteAsync(Guid id){try{await Api.DeleteAsync(id);orders=orders.Where(x=>x.Order.Id!=id).ToArray();}catch(Exception ex){error=ex.Message;}}
}
